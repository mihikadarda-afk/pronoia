# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Leave these out to run the demo family instead.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The AI dose check server (npm run serve / npm run dev:api). Never put this in a VITE_ variable.
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_URL=https://your-project.supabase.co    (with SUPABASE_ANON_KEY: only signed-in users can run checks)
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only when the app is hosted somewhere other than the server:
# VITE_API_URL=https://api.example.com
# ALLOWED_ORIGIN=https://app.example.com
